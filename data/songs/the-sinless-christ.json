{
  "id": "the-sinless-christ",
  "title": "The Sinless Christ",
  "slides": [
    {
      "label": "Verse 1",
      "lines": [
        "The sinless Christ",
        "You became sin for all",
        "You were taken from prison to judgment"
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        "Yet, You defended not Yourself",
        "Your visage was marred",
        "Beyond recognition"
      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        "Yet, it pleased You to take our place",
        "On that rugged cross"
      ]
    },
    {
      "label": "Verse 4",
      "lines": [
        "You served the claims of justice",
        "For our salvation",
        "Your death brought us salvation",
        "Your resurrection brought us",
        "Justification and eternal life",
        "The mystery that was hidden for ages",
        "Is being revealed in Your saints today",
        "Christ in us, the hope of glory"
      ]
    },
    {
      "label": "Verse 5",
      "lines": [
        "Unbroken",
        "Unrelenting is Your love",
        "Like a flooding ocean",
        "Overflowing its banks",
        "With kindness towards us",
        "Your tender mercy",
        "Extends to the earth of men",
        "Towering over us",
        "With the shielding",
        "Of Your glory"
      ]
    },
    {
      "label": "Verse 6",
      "lines": [
        "You came to express the Father’s will",
        "And the nature of God",
        "You are God’s love letter to us",
        "The revelation of the Father’s heart"
      ]
    },
    {
      "label": "Verse 7",
      "lines": [
        "You brought us health",
        "In Your name",
        "We exercise kingly power",
        "Righteousness and peace",
        "In You is safety and assurance"
      ]
    },
    {
      "label": "Verse 8",
      "lines": [
        "We are Your trophies",
        "The sign of Your victory",
        "Your vicarious death",
        "Resurrection and priesthood",
        "All are our coupons and vouchers",
        "For claimant by faith"
      ]
    },
    {
      "label": "Verse 9",
      "lines": [
        "We are sons of Your glory",
        "The sons of Your love",
        "With Your mark on us",
        "You’ve given us a uniqueness in grace",
        "That defies all legal presentation"
      ]
    },
    {
      "label": "Verse 10",
      "lines": [
        "And its consequences",
        "Forever more"
      ]
    },
